`timescale 1ns/1ps

module tb_flipflop_counter;

reg clk;
reg reset;
reg d;
wire q;
wire [3:0] count;

d_flipflop uut1(
    .clk(clk),
    .d(d),
    .q(q)
);

counter_4bit uut2(
    .clk(clk),
    .reset(reset),
    .count(count)
);

always #5 clk = ~clk;

initial begin
    clk = 0;
    reset = 1;
    d = 0;

    #10 reset = 0;
    #10 d = 1;
    #10 d = 0;
    #20 d = 1;

    #50 $finish;
end

endmodule
